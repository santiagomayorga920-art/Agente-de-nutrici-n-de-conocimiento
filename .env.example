# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alias que siempre apunta al modelo Flash vigente; puedes fijar uno concreto (p. ej. gemini-3.8-flash)
GEMINI_MODEL=gemini-flash-latest
# Se usa si el principal está saturado (503) o sin cuota (429)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Nota de voz de cada píldora (true/false) y modelos de voz de Gemini
VOICE_NOTES=true
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Sulafat
# Ilustración IA de la tarjeta; Cloudflare es opcional (sin él se usa Pollinations, sin cuenta)
ILLUSTRATIONS=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
# Tu chat_id de Telegram (el bot solo hablará contigo)
TELEGRAM_CHAT_ID=
# Base de datos: SQLite local por defecto; con Supabase, pega aquí la URI del "Session pooler"
DATABASE_PATH=data/nutricion.db
DATABASE_URL=
# Opcional: contraseña aparte; la URI puede llevar [YOUR-PASSWORD] tal cual
DATABASE_PASSWORD=
# Zona horaria para la racha de días (p. ej. America/Bogota, America/Mexico_City, Europe/Madrid)
TIMEZONE=UTC
# Solo para el servidor del webhook (Render lo genera solo)
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=
