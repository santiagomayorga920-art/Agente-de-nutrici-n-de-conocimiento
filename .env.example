# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo de Gemini; cámbialo si Google lo retira o si quieres más cuota gratuita (p. ej. un "flash-lite")
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=
# Tu chat_id de Telegram (el bot solo hablará contigo)
TELEGRAM_CHAT_ID=
DATABASE_URL=sqlite:///nutricion.db
